# pixi environments
.pixi/*
!.pixi/config.toml
/outputs
/slurm_outputs
/graphOutputs
/substrate

# Simulation configs are local, only the templates are tracked
/sim_configs/*
!/sim_configs/config_template*.toml

archive_Cole
archive_Ricardo

# Python bytecode cache
__pycache__/

# Substrate configs are local, only the templates are tracked
/substrate_configs/*
!/substrate_configs/*_template.toml
